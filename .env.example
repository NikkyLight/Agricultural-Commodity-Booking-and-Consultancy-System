# Copy to .env and fill in. Never commit the real .env file.

# Port the server listens on (default 5000).
PORT=5000

# REQUIRED for login. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Optional. Comma-separated origins allowed to call the API from another site.
# Leave empty to allow only the frontend served by this app.
CORS_ORIGINS=

# Optional. Used only by `npm run create-admin` when set (otherwise you are prompted).
ADMIN_PASSWORD=
